# Database values for this deployment.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Preserve the existing key when migrating encrypted data.
SECRET_KEY=

# Public HTTPS origin, without a trailing slash.
APP_URL=https://shop.example.com
TRUSTED_PROXY_IPS=

# Enable only after configuring the channel and verified webhook URL.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_MIN_AMOUNT=1000
PAYOS_MAX_AMOUNT=50000000
PAYOS_EXPIRE_MINUTES=15

# --- GachtheFast (GTF) -------------------------------------------------------
# The GachtheFast integration ships DISABLED and CREDIT-LOCKED. Do not flip anything before:
#   - the owner questionnaire in docs/gachthefast/08-verification-and-owner-questionnaire.md
#     has been answered (provider origin, request format, response contract, credit rules),
#   - scripts/migrate-gtf.php has been run on a backed-up database,
#   - the card API and its tests have been executed against a disposable environment,
#   - the gates in docs/gachthefast/12-staging-and-release-plan.md are signed off (note the
#     open P1 SEC-01 in docs/gachthefast/10-security-review.md: crediting stays OFF until the
#     operator credit path is bound to the verified amount).
# Operating procedures, monitoring queries and the rollback contract live in
# docs/gachthefast/11-operator-runbook.md.
# There is deliberately NO bank configuration: no GachtheFast bank contract is confirmed, so
# the bank flow is a fail-closed stub that never contacts the provider and never credits.
# Secrets stay blank here and only ever exist in the deployment's real .env.

# Enables the card surface. false = customers cannot submit cards.
GTF_CARD_ENABLED=false
# Lock that allows money to be credited to a wallet. Keep false until the provider contract
# and the credit rules are confirmed; while false, any credit candidate is parked for review.
GTF_ALLOW_CREDITING=false

# The API origin must be configured EXPLICITLY — no default and no guessing. Use exactly the
# HTTPS origin the provider confirms for the API (the public documentation only shows a
# placeholder host), with no path, query, credentials or non-443 port.
GTF_API_BASE=

# The request body format must also be configured EXPLICITLY, because the provider's page is
# contradictory (JSON content-type next to a form-data example).
#   json = POST /chargingws/v2 with a JSON body
#   form = POST /chargingws/v2 with an application/x-www-form-urlencoded body
# Leave blank to keep the card client refusing to make any request.
GTF_CARD_REQUEST_FORMAT=

# Partner credentials issued by GachtheFast. Never commit real values.
# Rotating GTF_PARTNER_KEY invalidates callback signatures until the provider is updated.
GTF_PARTNER_ID=
GTF_PARTNER_KEY=

GTF_CARD_MIN_AMOUNT=10000
GTF_CARD_MAX_AMOUNT=2000000
# Shop fee kept from a card before crediting the wallet, in percent (0 = no fee).
GTF_CARD_FEE_PERCENT=0

# cURL connect/read timeout for provider calls, seconds (3..30).
GTF_TIMEOUT_SECONDS=10
# Secret that authorises cron/gtf-card.php and cron/gtf-bank.php over HTTP. Leave blank to
# allow them from the CLI only (recommended). If set, send it as the X-GTF-Cron-Token header
# and still prefer CLI: a token in a query string can leak into access logs and Referer.
GTF_CRON_TOKEN=

# Register this URL with GachtheFast as the card callback (built from APP_URL):
#   {APP_URL}/api/callback-gtf-card.php
#
# SECRET_KEY (above) seals the card PIN/serial for orders that are still open. It must be set
# before any card can be stored, and it must NOT be rotated while orders still hold sealed data:
# they become unreadable and are parked for manual review. Check first:
#   SELECT COUNT(*) FROM gtf_card_orders WHERE serial_sealed IS NOT NULL OR code_sealed IS NOT NULL;

# --- Orbit Office licence client --------------------------------------------
# Connects this shop to the licence portal (tools/license-portal). The storefront
# and every payment flow work WITHOUT this: only the admin features that already
# include models/is_license.php consult the licence. Leave LICENCE_PORTAL_URL blank
# to keep the client switched off entirely.
#
# Must be a bare HTTPS origin, exactly as registered with the portal:
#   LICENCE_PORTAL_URL=https://orbit-license-portal.onrender.com
LICENCE_PORTAL_URL=

# cURL read timeout for portal calls, in seconds (3..30, default 10). The free
# Render instance sleeps after 15 minutes idle and can take 30-60 s to wake, so
# keep the default and let the keep-warm monitor (Uptime Kuma) absorb cold starts.
LICENCE_TIMEOUT_SECONDS=10

# How long the shop may keep working on the last successful check while the
# portal is unreachable, in days (0..365, default 30). 0 disables offline use.
LICENCE_GRACE_DAYS=30

# true = the gated admin pages verify the licence before they open (recommended
# once a key is entered); false = report-only, nothing is blocked.
LICENCE_ENFORCE=false

# --- Cron / worker endpoints -------------------------------------------------
# cron/*.php (bank polling, supplier balance sync, automations, the mail queue) were callable by
# anyone who knew the path. They now require CLI, or an HTTP request carrying this token as an
# X-Cron-Token header (preferred) or ?token=. At least 16 characters; blank = HTTP refused.
#   curl -H "X-Cron-Token: $CRON_TOKEN" https://shop.example.com/cron/bank.php
# Never put the token in a URL that ends up in a screenshot, Referer or access log.
CRON_TOKEN=
